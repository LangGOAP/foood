# Model prices the bench uses to cost a run, in USD per million tokens. Every results
# file records the prices it was given, so a cost is never without its provenance.
# gpt-5.4-mini: OpenAI's model page (developers.openai.com/api/docs/models/gpt-5.4-mini)
# and OpenRouter's model list, both read on 2026-11-17. Cached input (0.075) is not modelled.
FOOOD_LLM_PRICE_IN=0.75
FOOOD_LLM_PRICE_OUT=4.50
# Per-model prices for the branches whose nodes run different models (#46), USD per million
# tokens, from OpenAI's pricing page (developers.openai.com/api/docs/pricing) read on
# 2026-11-18: gpt-5.4 2.50 in / 15.00 out, gpt-5.4-mini 0.75 / 4.50, gpt-5.4-nano 0.20 / 1.25.
# Cached input (0.25, 0.075, 0.02) is not modelled. A model not listed here falls back to the
# pair above; a run names the model of every call, so each is costed at its own price.
FOOOD_LLM_PRICES={"gpt-5.4": {"in": 2.50, "out": 15.00}, "gpt-5.4-mini": {"in": 0.75, "out": 4.50}, "gpt-5.4-nano": {"in": 0.20, "out": 1.25}}
